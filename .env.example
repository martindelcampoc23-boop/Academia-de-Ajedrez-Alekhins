# DATABASE (Supabase PostgreSQL)
DATABASE_URL="postgres://postgres.[ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
DIRECT_URL="postgres://postgres.[ref]:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

# SUPABASE CLIENT
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# SUPABASE STORAGE (Fase 5)
# Crea el bucket "alekhins-files" en Supabase Dashboard → Storage
# con política pública de lectura (INSERT/SELECT permitidos).
SUPABASE_STORAGE_BUCKET="alekhins-files"


# AUTHENTICATION (NextAuth)
NEXTAUTH_SECRET="your-nextauth-secret-key-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# GOOGLE OAUTH
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# STRIPE PAYMENTS
STRIPE_SECRET_KEY="sk_test_mock_alekhins_key"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_mock_alekhins_key"
STRIPE_WEBHOOK_SECRET="whsec_mock_alekhins_webhook_secret"

# SITE CONFIGURATION
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Academia de Ajedrez Alekhins"
NEXT_PUBLIC_WHATSAPP_NUMBER="525500000000"
